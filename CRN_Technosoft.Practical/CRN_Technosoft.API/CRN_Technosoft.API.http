@baseUrl = http://localhost:5098
@token = replace-with-access-token
@refreshToken = replace-with-refresh-token

### Register a user (receives the Customer role)
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "userName": "api-user",
  "email": "api-user@example.com",
  "password": "ChangeThis123!"
}

### Login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "api-user@example.com",
  "password": "ChangeThis123!"
}

### Rotate refresh token
POST {{baseUrl}}/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

### List products (maximum page size: 100)
GET {{baseUrl}}/api/products?pageIndex=1&totalLength=10
Accept: application/json

### Get a product
GET {{baseUrl}}/api/products/1
Accept: application/json

### Missing product returns RFC 7807 Problem Details
GET {{baseUrl}}/api/products/2147483647
Accept: application/json

### Create a product (requires ProductManager/Admin/SuperAdmin role)
POST {{baseUrl}}/api/products
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "productName": "Wireless Mouse"
}

### Update a product
PUT {{baseUrl}}/api/products/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "id": 1,
  "productName": "Ergonomic Wireless Mouse"
}

### Delete a product
DELETE {{baseUrl}}/api/products/1
Authorization: Bearer {{token}}

### Get items for a product
GET {{baseUrl}}/api/items?productId=1&pageIndex=1&pageSize=10
Accept: application/json

### Get an item
GET {{baseUrl}}/api/items/1
Accept: application/json

### Create an item
POST {{baseUrl}}/api/items
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "productId": 1,
  "quantity": 10
}

### Update an item
PUT {{baseUrl}}/api/items/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "productId": 1,
  "quantity": 12
}

### Delete an item
DELETE {{baseUrl}}/api/items/1
Authorization: Bearer {{token}}
